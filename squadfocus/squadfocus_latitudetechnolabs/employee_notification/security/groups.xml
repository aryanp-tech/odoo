<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="super_admin_category" model="ir.module.category">
            <field name="name">Super Admin</field>
            <field name="sequence">99</field>
        </record>

        <record id="group_super_admin" model="res.groups">
            <field name="name">Super Admin</field>
            <field name="category_id" ref="employee_notification.super_admin_category"/>
            <field name="comment">Group for administrators who can access all features of Quarterly Review.</field>
        </record>
        <!-- Define a security rule for employees to view their own records -->
        <record id="employee_own_records_rule" model="ir.rule">
            <field name="name">Employee Own Records Rule</field>
            <field name="model_id" ref="model_hr_employee"/>
            <field name="domain_force">['|','|',('user_id', '=', user.id),('id','=',user.employee_id.parent_id.id),('parent_id','=',user.employee_id.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="groups" eval="[(6, 0, [ref('hr.group_hr_user')])]"/>
        </record>
    </data>
</odoo>
