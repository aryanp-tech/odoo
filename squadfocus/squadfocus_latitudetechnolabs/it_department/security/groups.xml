<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_it_officer" model="res.groups">
            <field name="name">IT Officer</field>
        </record>
        
        <record id="module_it_admin" model="res.groups">
            <field name="name">IT Admin</field>
            <field name="implied_ids" eval="[(4, ref('it_department.module_it_officer'))]"/>
        </record>

        <record model="ir.rule" id="it_employee_admin_rule">
            <field name="name">All Employees Record can Access By IT Team</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">[ (1, '=',1)]</field>
            <field name="groups" eval="[(4, ref('it_department.module_it_officer')),(4, ref('it_department.module_it_admin'))]"/>
        </record>
    </data>
</odoo>