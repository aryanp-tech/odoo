<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cron_mark_daily_absent" model="ir.cron">
        <field name="name">Mark Incomplete Attendance Days As Absent</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="state">code</field>
        <field name="code">model._cron_mark_daily_absent()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 17:45:00')"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>

</odoo>
