<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_weekly_review_form" model="ir.ui.view">
            <field name="name">weekly.review.form</field>
            <field name="model">weekly.review</field>
            <field name="arch" type="xml">
                <form string="Weekly Review">
                    <group>
                        <group>
                            <field name="parent_id"/>
                            <field name="project_id"/>
                            <!-- <field name="review"/> -->
                        </group>
                    </group>
                    <notebook>
                            <page string="review" name="review">
                                <field name="review"
                                    widget="section_and_note_one2many">
                                    <tree string="Purchase Order Lines" editable="bottom">
                                        <field name="created_date"/>
                                        <field name="description"/>
                                        <field name="priority"/>
                                        <field name="points"/>
                                    </tree>
                                </field>
                            </page>
                    </notebook>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="points_count"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="view_weekly_review_tree" model="ir.ui.view">
            <field name="name">weekly.review.tree</field>
            <field name="model">weekly.review</field>
            <field name="arch" type="xml">
                <tree string="weekly Review" sample="1">
                    <field name="parent_id"/>
                    <field name="project_id"/>
                    <field name="review"/>
                    <!-- <field name="created_date"/>
                    <field name="priority"/> -->
                </tree>
            </field>
        </record>

        <record id="view_weekly_review_search" model="ir.ui.view">
            <field name="name">weekly.review.search</field>
            <field name="model">weekly.review</field>
            <field name="arch" type="xml">
                <search string="Weekly Review">
                    <field name="parent_id"/>
                </search>
            </field>
        </record>

        
        <record id="weekly_review_view_kanban" model="ir.ui.view">
            <field name="name">weekly.review.view.kanban</field>
            <field name="model">weekly.review</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_small_column o_opportunity_kanban">
                    <field name="parent_id"/>
                    <field name="project_id"/>
                    <field name="review"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click overflow-hidden">
                                <div class="row my-auto">
                                    <div class="col-8">
                                        <h1 class="o_kanban_record_title"><field name="parent_id"/></h1>
                                        <div>project: <field name="project_id"/></div>
                                        <div>priority: <field name="review"/></div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="action_tl" model="ir.actions.act_window">
            <field name="name">Weekly Review</field>
            <field name="res_model">weekly.review</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="view_weekly_review_search"/>
            <field name="context">{"search_default_Current":1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                Ready to create a record?
                </p>
                <p>
                Let's create a record.
                </p>
            </field>
        </record>
        <menuitem id="tl_catagories" name="Weekly Review" action="action_tl" groups="module_tl_employee"/>


        <record id="view_weekly_review_field_form" model="ir.ui.view">
            <field name="name">weekly.review.form</field>
            <field name="model">weekly.review.field</field>
            <field name="arch" type="xml">
                <form string="Weekly Review Field">
                    <group>
                        <group>
                            <!-- <field name="test_id"/> -->
                            <field name="description"/>
                            <field name="priority"/>
                            <field name="created_date"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>


    </data>
</odoo>
