<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="survey_response_line_view_inherited_sf" model="ir.ui.view">
        <field name="name">survey.user_input.line.view.tree</field>
        <field name="model">survey.user_input.line</field>
        <field name="inherit_id" ref="survey.survey_response_line_view_tree"/>
        <field name="arch" type="xml">
                <xpath expr="//field[@name='answer_type']" position="after">
                    <field name="client_answer"/>
                </xpath>
            </field>
    </record>

    <record id="hr_appraisal_survey_inherited" model="ir.ui.view">
        <field name="name">hr_appraisal list inherit</field>
        <field name="model">survey.user_input</field>
        <field name="priority">1</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='answer_type']" position="after">
                <field name="client_answer"/>
            </xpath>
        </field>
    </record>
</odoo>
