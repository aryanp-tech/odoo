<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="employee_ticket_rule_admin" model="ir.rule">
            <field name="name">Employee Ticket Rule for Admins</field>
            <field name="model_id" ref="model_employee_ticket"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
        </record>
        <record id="employee_ticket_rule_user" model="ir.rule">
            <field name="name">Employee Ticket Rule for IT Admin</field>
            <field name="model_id" ref="model_employee_ticket"/>
            <field name="domain_force">[('topic', '=', 'it_related')]</field>
            <field name="groups" eval="[(4, ref('it_department.module_it_admin'))]"/>
        </record>
        <record id="employee_ticket_rule_user" model="ir.rule">
            <field name="name">Employee Ticket Rule for Users</field>
            <field name="model_id" ref="model_employee_ticket"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>
    </data>
</odoo>
