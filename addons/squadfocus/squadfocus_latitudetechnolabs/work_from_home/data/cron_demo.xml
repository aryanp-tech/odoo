<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="employee_send_wfh_to_manager" model="ir.cron">
            <field name="name">Send mail for take action on wfh request </field>
              <field name="model_id" ref="model_work_from_home"/>
              <field name="state">code</field>
              <field name="code">model.cron_send_wfh_manager()</field>
              <field name="user_id" ref="base.user_root"/>
              <field name="nextcall" eval="(DateTime.now() +     timedelta(days=1)).strftime('%Y-%m-%d 10:00:00')" />
              <field name='interval_number'>1</field>
              <field name='interval_type'>days</field>
              <field name="numbercall">-1</field>
              <field name="doall" eval="False"/>
        </record>

        <record id="email_wfh_to_manager" model="mail.template">
            <field name="name">Approve/Refuse Wfh Request</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="auto_delete" eval="False"/>
            <field name="email_from">${}</field>
            <field name="email_to">${}</field>
            <field name="subject">Approve/Refuse Wfh Request</field>
            <field name="body_html">
            <![CDATA[
            <p>Dear Following
            <br/>
            <br/>
            Good job, this is our first e-mail template!<br/>
            </p>
            Regards,<br/>
            ]]></field>
        </record>

    </data>
</odoo>