<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="quarterly_review_category" model="ir.module.category">
            <field name="name">Quarterly Review</field>
            <field name="sequence">99</field>
        </record>

        <record id="group_quarterly_review_super_admin" model="res.groups">
            <field name="name">Quarterly Review Super Admin</field>
            <field name="category_id" ref="quarterly_review.quarterly_review_category"/>
            <field name="comment">Group for administrators who can access all features of Quarterly Review.</field>
        </record>
        <record id="quarterly_review_rule_super_admin" model="ir.rule">
            <field name="name">Quarterly Review Rule for Super Admins</field>
            <field name="model_id" ref="model_quarterly_review"/>
            <field name="domain_force">[('state', 'in',["done"])]</field>
            <field name="groups" eval="[(4, ref('quarterly_review.group_quarterly_review_super_admin'))]"/>
        </record>
        <record id="quarterly_review_rule_admin" model="ir.rule">
            <field name="name">Quarterly Review Rule for Admins</field>
            <field name="model_id" ref="model_quarterly_review"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
        </record>
        <record id="quarterly_review_rule_user" model="ir.rule">
            <field name="name">Quarterly Review Rule for Users</field>
            <field name="model_id" ref="model_quarterly_review"/>
            <field name="domain_force">[('name', '=', user.employee_id.id),('state', 'in',["sent","submit"]),('is_submit', '=',False),('is_manager', '=',True)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>
        <record id="quarterly_review_rule_manager" model="ir.rule">
            <field name="name">Quarterly Review Rule for Managers</field>
            <field name="model_id" ref="model_quarterly_review"/>
            <field name="domain_force">[('manager_id', 'in', [user.employee_id.id]),('state', 'in',["submit"]),('is_manager', '=',False)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>
        
    </data>
</odoo>
