<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="probation_employee_rule_admin" model="ir.rule">
            <field name="name">Probation Employee Rule for Admins</field>
            <field name="model_id" ref="model_probation_employee"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('oh_appraisal.group_appraisal_manager'))]"/>
        </record>

        <record id="probation_employee_rule_user" model="ir.rule">
            <field name="name">Probation Employee Rule for Users</field>
            <field name="model_id" ref="model_probation_employee"/>
            <field name="domain_force">[('name.id', '=', user.employee_ids.id)]</field>
            <field name="groups" eval="[(4, ref('oh_appraisal.group_appraisal_employee'))]"/>
        </record>
        
    </data>
</odoo>
