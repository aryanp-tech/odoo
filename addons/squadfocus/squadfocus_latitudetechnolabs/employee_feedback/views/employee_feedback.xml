<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_employee_feedback_form" model="ir.ui.view">
            <field name="name">employee.feedback.form</field>
            <field name="model">employee.feedback</field>
            <field name="arch" type="xml">
                <form string="Job">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_employee_feedback"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o">
                                <field string="Answers" name="emp_count_survey" widget="statinfo"/>
                            </button>
                        </div>
                    <group>
                        <group>
                            <field name="name" options="{'no_create': 1}"/>
                            <field name='lead_id'/>
                            <field name='create_date'/>
                          </group>
                        <group>
                            <field name="survey_id"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                </sheet>
                </form>
            </field>
        </record>

        <record id="view_employee_feedback_tree" model="ir.ui.view">
            <field name="name">employee.feedback.tree</field>
            <field name="model">employee.feedback</field>
            <field name="arch" type="xml">
                <tree string="Job" sample="1">
                    <field name="name"/>
                    <field name='lead_id'/>
                    <field name="survey_id"/>
                    <field name='create_date'/>
                    <field name="expiry_date"/>
                    <field string="Answers" name="emp_count_survey" widget="statinfo"/>
                    <button name="action_employee_feedback"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o">
                                <field string="Answers" name="emp_count_survey" widget="statinfo"/>
                    </button>
                </tree>
            </field>
        </record>

        <record id="view_employee_feedback_filter" model="ir.ui.view">
            <field name="name">employee.feedback.search</field>
            <field name="model">employee.feedback</field>
            <field name="arch" type="xml">
                <search string="Employees">
                    <field name="name"/>
                    <filter string="Group by Week" name="group_by_week" domain="[]" context="{'group_by':'create_date:week'}"/>
                    <filter string="Employee" name="group_by_employeename" domain="[]" context="{'group_by':'name'}"/>
                </search>
            </field>
        </record>

        <record id="action_employee_feedback" model="ir.actions.act_window">
            <field name="name">Employee Feedback</field>
            <field name="res_model">employee.feedback</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Ready to create a Feedback?
              </p>
              <p>
                Let's create a Feedback.
              </p>
            </field>
        </record>
        <menuitem id="menu_employee_feedback"  action="action_employee_feedback" name="Employee Feedback"/>

    </data>
</odoo>
