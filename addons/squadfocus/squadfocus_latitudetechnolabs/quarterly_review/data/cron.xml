<?xml version="1.0" encoding='UTF-8'?>
<odoo>
    <data noupdate="1">
        <record id="quarterly_review_cron" model="ir.cron">
            <field name="name">Quarterly Review Cron</field>
            <field name="model_id" ref="model_quarterly_review"/>
            <field name="state">code</field>
            <field name="code">model.cron_quarterly_review_create()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="nextcall" eval="(DateTime.now() +  timedelta(days=1)).strftime('%Y-%m-%d 11:00:00')" />
            <field name='interval_number'>1</field>
            <field name='interval_type'>days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
        </record>

