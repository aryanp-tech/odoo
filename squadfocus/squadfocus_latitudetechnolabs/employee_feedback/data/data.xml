<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="employee_feedback_to_manager" model="ir.cron">
            <field name="name">Feedback for Manager</field>
              <field name="model_id" ref="model_employee_feedback"/>
              <field name="state">code</field>
              <field name="code">model.cron_manager_feedback()</field>
              <field name="user_id" ref="base.user_root"/>
              <field name="nextcall" eval="(DateTime.now() +     timedelta(days=1)).strftime('%Y-%m-%d 10:00:00')" />
              <field name='interval_number'>1</field>
              <field name='interval_type'>days</field>
              <field name="numbercall">-1</field>
              <field name="doall" eval="False"/>
        </record>
</data>
</odoo>