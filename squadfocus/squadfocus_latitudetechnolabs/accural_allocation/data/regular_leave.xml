<?xml version="1.0" encoding='UTF-8'?>
<odoo>
	<record model="ir.cron" id="send_regular_leave">
        <field name="name">Send Leave: Regular Leave Allocation</field>
        <field name="model_id" ref="model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">model._regular_leave()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>

    <record model="ir.cron" id="work_from_home_allocate">
        <field name="name">Allocate Work From Home</field>
        <field name="model_id" ref="model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">model.quarterly_wfh_allocate()</field>
        <field name="interval_number">3</field>
        <field name="interval_type">months</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>
</odoo>