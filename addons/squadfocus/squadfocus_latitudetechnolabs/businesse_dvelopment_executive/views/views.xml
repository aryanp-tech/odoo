<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_bde_form" model="ir.ui.view">
            <field name="name">bussiness.development.form</field>
            <field name="model">bussiness.development</field>
            <field name="arch" type="xml">
                <form string="Job">
                    <group>
                        <group>
                            <field name="parent_id"/>
                            <field name="department_id"/>
                            <field name="description"/>
                            <field name="user_id"/>
                            <field name="client"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record id="view_bde_tree" model="ir.ui.view">
            <field name="name">bussiness.development.tree</field>
            <field name="model">bussiness.development</field>
            <field name="arch" type="xml">
                <tree string="Job" sample="1">
                    <field name="parent_id"/>
                    <field name="department_id"/>
                    <field name="description"/>
                    <field name="user_id"/>
                    <field name="client"/>
                </tree>
            </field>
        </record>

        <record id="view_bde_search" model="ir.ui.view">
            <field name="name">bussiness.development.search</field>
            <field name="model">bussiness.development</field>
            <field name="arch" type="xml">
                <search string="Jobs">
                    <field name="parent_id"/>
                </search>
            </field>
        </record>

        
        <record id="bussiness_development_view_kanban" model="ir.ui.view">
            <field name="name">bussiness.development.view.kanban</field>
            <field name="model">bussiness.development</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column o_opportunity_kanban" 
                    archivable="false" sample="1">
                    <field name="parent_id"/>
                    <field name="user_id"/>
                    <field name="client"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click overflow-hidden">
                                <div class="row my-auto">
                                    <div class="col-8">
                                        <h1 class="o_kanban_record_title"><field name="parent_id"/></h1>
                                        <div>Level: <field name="user_id"/></div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="action_bde" model="ir.actions.act_window">
            <field name="name">record</field>
            <field name="res_model">bussiness.development</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="view_bde_search"/>
            <field name="context">{"search_default_Current":1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                Ready to create a record?
                </p>
                <p>
                Let's create a record.
                </p>
            </field>
        </record>
        <menuitem id="bde_catagories" name="Client Detail" action="action_bde" groups="module_bde_employee"/>
    </data>
</odoo>
