<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
    <record id="form_public_holidays_form_view" model="ir.ui.view">
        <field name="name">public.holidays.form.view</field>
        <field name="model">public.holidays</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <form string="Public Holidays ">
                <sheet>
                    <h2>
                        <field name="name" nolabel="1" />
                    </h2>
                    <field name='holidays_line' widget="one2many">
                        <tree>
                            <field name ='name'/>
                            <field name='leave_date'/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="public_holidays_view_tree" model="ir.ui.view">
        <field name="name">public.holidays.view.tree</field>
        <field name="model">public.holidays</field>
        <field name="arch" type="xml">
            <tree string="Public Holidays">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_public_holidays" model="ir.actions.act_window">
        <field name="name">Public Holidays</field>
        <field name="res_model">public.holidays</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="public_holidays_catagories" parent="hr_holidays.menu_hr_holidays_root" action="action_public_holidays" name="Public Holidays"
        sequence="6"/>
    
</odoo>
