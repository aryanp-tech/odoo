<?xml version="1.0" encoding="utf-8"?>
<odoo>
        
    <record id="resource_calendar_form_inherit_employee_attendance" model="ir.ui.view">
        <field name="name">resource.calendar.form.inherit.attendance</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.resource_calendar_form"/>
          <field name="arch" type="xml">
            <xpath expr="//group[@name='resource_details']" position="inside">
                <group>
                    <field name="start_hour" widget="float_time"/>
                </group>
            </xpath>
       </field>
    </record>

</odoo>