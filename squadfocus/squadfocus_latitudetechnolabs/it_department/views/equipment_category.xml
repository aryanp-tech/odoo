<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_equipment_category_form" model="ir.ui.view">
            <field name="name">equipment.category.form</field>
            <field name="model">equipment.category</field>
            <field name="arch" type="xml">
                <form string="Equipment ">
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                            <span class="o_stat_text">
                                    <span class="o_stat_text">
                                      Total Quantity  <field name='quantity'/>
                                    </span>
                                    <span class="o_stat_text">
                                        Available Quantity  <field name='avail_quantity'/>
                                      </span>
                                <button name="action_open_filtered_records" type="object" string="All Related Products" class="oe_stat_button"/>
                            </span>
                        </div>
                        <group>
                            <group>
                                <field name="category"/>
                                <field name='name'/>
                                <field name='tag_code'/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_equipment_category_tree" model="ir.ui.view">
            <field name="name">equipment.category.tree</field>
            <field name="model">equipment.category</field>
            <field name="arch" type="xml">
                <tree string="Job" sample="1">
                    <field name="category"/>
                    <field name="name"/>
                    <field name='avail_quantity'/>
                    <field name='tag_code'/>
                </tree>
            </field>
        </record>

        <record id="view_equipment_category_filter" model="ir.ui.view">
            <field name="name">equipment.category.search</field>
            <field name="model">equipment.category</field>
            <field name="arch" type="xml">
                <search string="Jobs">
                    <field name="name"/>
                </search>
            </field>
        </record>

        <record id="action_equipment_category" model="ir.actions.act_window">
            <field name="name">Equipment Category</field>
            <field name="res_model">equipment.category</field>
            <field name="view_mode">tree,form</field>
        </record>
        
        <menuitem id="equipment_category_menu" parent="it_department.menu_asset_details" action="action_equipment_category" name="Product Category"
        sequence="30"/>

    </data>
</odoo>
