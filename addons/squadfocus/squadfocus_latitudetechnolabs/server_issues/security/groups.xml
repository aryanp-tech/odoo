<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="server_issue_category" model="ir.module.category">
            <field name="name">Server Issue Creation</field>
            <field name="sequence">99</field>
        </record>

        <record id="group_server_issue_admin" model="res.groups">
            <field name="name">Server Issue Admin</field>
            <field name="category_id" ref="server_issues.server_issue_category"/>
            <field name="comment">Group for administrators who can access all features of Server Access.</field>
        </record>

        <record id="group_server_issue_user" model="res.groups">
            <field name="name">Server Issue User</field>
            <field name="category_id" ref="server_issues.server_issue_category"/>
            <field name="comment">Group for administrators who can access Only his/her records.</field>
        </record>
        
        <record id="server_issue_rule_admin" model="ir.rule">
            <field name="name">Server Issue Rule for Admins</field>
            <field name="model_id" ref="model_server_issue"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('server_issues.group_server_issue_admin'))]"/>
        </record>
        <record id="server_issue_rule_user" model="ir.rule">
            <field name="name">Server Issue Rule for Users</field>
            <field name="model_id" ref="model_server_issue"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('server_issues.group_server_issue_user'))]"/>
        </record>
    </data>
</odoo>
